# Puerto en el que se ejecutará el servidor HTTP
PORT=3000

# Entorno de ejecución (development | test | production)
NODE_ENV=development

# URI de conexión a la base de datos MongoDB
MONGO_URI=mongodb://localhost:27017/shipnow

# Rondas de salt para el hasheo de contraseñas con Bcrypt
SALT_ROUNDS=10

# Clave secreta para firmar y verificar tokens JWT
JWT_SECRET=your_jwt_secret_key

# Tiempo de expiración de los tokens JWT
JWT_EXPIRES_IN=4h

# Nivel de logs de Winston (debug | info | warn | error | fatal)
LOG_LEVEL=debug

# Habilitar endpoints internos en producción (true | false)
ENABLE_INTERNAL_ENDPOINTS=false

# URL del cliente web / frontend para políticas CORS
CLIENT_URL=http://localhost:3000